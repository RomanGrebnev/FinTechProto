# Mistral API key — leave empty to run in demo mode (canned recommendations)
MISTRAL_API_KEY=
# Model to use (default mistral-large-latest; some plans only allow e.g. mistral-small-latest)
MISTRAL_MODEL=
# Postgres connection used by the backend
DATABASE_URL=postgresql+psycopg://wealthpilot:wealthpilot@db:5432/wealthpilot
# Secret used to sign JWTs — change this
JWT_SECRET=change-me-to-a-long-random-string
